# ==========================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Copy this file to .env for local development.
# On Vercel, set these in Project Settings -> Environment Variables.
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO GITHUB.
# ==========================================

# Database Connection (Neon PostgreSQL) - REQUIRED [SECRET]
# Supports DATABASE_URL or POSTGRES_URL (Vercel Neon Integration)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require
# POSTGRES_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Database Type - Optional (defaults to 'postgres' when DATABASE_URL is set)
DB_TYPE=postgres

# JWT Secret Key - REQUIRED [SECRET]
JWT_SECRET=your_super_secret_jwt_random_key_here

# Local Development Server Port - Optional (defaults to 5000)
PORT=5000

# Library QR Code Identifier - Optional [PUBLIC / CONFIG]
LIBRARY_QR_CODE=SMART_LIBRARY_QR_2026

# Initial Admin Seeding Credentials - Optional [SECRET]
ADMIN_USERNAME=admin@lj.edu
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=Library Admin
ADMIN_EMAIL=admin@lj.edu
