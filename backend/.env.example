# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_here

# QR Code Configuration
LIBRARY_QR_CODE=SMART_LIBRARY_QR_2026

# Admin Default Credentials (used for initial seeding)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Library Admin
ADMIN_EMAIL=admin@library.com

# Database Selection: 'postgres' (Neon Cloud), 'sqlite', or 'mysql'
DB_TYPE=postgres
DATABASE_URL=postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# MySQL Configuration (Only used if DB_TYPE=mysql)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=library_system
